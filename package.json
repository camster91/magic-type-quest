{
  "name": "magic-type-quest",
  "version": "1.0.0",
  "description": "A beautiful, immersive typing game for kids — built for the web with gorgeous Canvas animations, AI-generated character art, and PWA support.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:v2": "vite build --mode v2-preview",
    "verify:local-only-build": "node scripts/verify-local-only-build.mjs dist",
    "verify:cloud-boundary": "node scripts/verify-cloud-boundary.mjs",
    "preview": "vite preview",
    "test": "vitest",
    "validate:curriculum": "vitest run test/v2-curriculum.test.js",
    "validate:mastery": "vitest run test/v2-mastery.test.js",
    "validate:content": "vitest run test/v2-content.test.js",
    "validate:assets": "node scripts/validate-v2-assets.mjs && vitest run test/v2-assets.test.js",
    "validate:input": "vitest run test/v2-input.test.js",
    "validate:persistence": "playwright test --config playwright.persistence.config.js",
    "test:e2e": "npm run build && npm run verify:local-only-build && playwright test e2e/accessibility.e2e.js e2e/app.e2e.js e2e/curriculum.e2e.js e2e/localization-layout.e2e.js",
    "test:e2e:v2": "npm run build:v2 && npm run verify:local-only-build && playwright test e2e/v2-shell.e2e.js e2e/v2-shell-journeys.e2e.js e2e/v2-input.e2e.js e2e/v2-persistence-ui.e2e.js",
    "typecheck:v2": "tsc -p tsconfig.v2.json",
    "lint": "eslint src test e2e scripts/*.mjs playwright*.config.js",
    "check:v2-theme": "node scripts/check-v2-theme.mjs",
    "test:v2-theme": "node --test test/v2-theme-guard.node.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/camster91/magic-type-quest.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/camster91/magic-type-quest/issues"
  },
  "homepage": "https://github.com/camster91/magic-type-quest#readme",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "^4.1.11"
  },
  "optionalDependencies": {
    "@supabase/supabase-js": "^2.112.4"
  },
  "dependencies": {
    "phaser": "4.2.1"
  }
}
